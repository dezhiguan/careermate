# Copy to .env for local development. Never commit real API keys or .env.app.

SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Spring reads DB_URL / DB_USERNAME / DB_PASSWORD (DATABASE_* below are documentation aliases)
DB_URL=jdbc:postgresql://localhost:5432/careermate_db
DB_USERNAME=careermate
DB_PASSWORD=change_me

JWT_SECRET=change-me-in-dev-only-change-me-in-dev-only
JWT_EXPIRATION_MS=86400000

# Auth Gateway (current auth source of truth)
AUTH_GATEWAY_BASE_URL=http://localhost:8090
AUTH_GATEWAY_ISSUER=https://auth.careermate.cn
AUTH_GATEWAY_AUDIENCE=careermate-api
AUTH_GATEWAY_TOKEN_ENDPOINT_AUDIENCE=https://auth.careermate.cn/oauth/token
AUTH_GATEWAY_CLIENT_ID=careermate-backend
AUTH_GATEWAY_CLIENT_ASSERTION_PRIVATE_KEY=config/keys/careermate-backend.pem
AUTH_GATEWAY_CLIENT_ASSERTION_KID=careermate-backend
AUTH_GATEWAY_REFRESH_COOKIE_NAME=cm_refresh
AUTH_GATEWAY_REFRESH_COOKIE_DOMAIN=
AUTH_GATEWAY_REFRESH_COOKIE_PATH=/api/auth
AUTH_GATEWAY_REFRESH_COOKIE_SECURE=false
AUTH_GATEWAY_TIMEOUT_MS=3000
AUTH_EVENT_HMAC_SECRET=
AUTH_EVENT_SIGNATURE_HEADER=X-Auth-Event-Signature
AUTH_EVENT_TIMESTAMP_HEADER=X-Auth-Event-Timestamp
AUTH_EVENT_IDEMPOTENCY_TTL=7d
AUTH_REVOKED_JTI_TTL=7d
AUTH_USER_REVOCATION_TTL=30d
TRUST_PROXY_HEADERS=false

# LLM Provider: mock | deepseek | qwen | openai-compatible
LLM_PROVIDER=mock
LLM_MODEL=mock-chat
LLM_ENDPOINT=
LLM_API_KEY=

# Qwen example (configure only on server .env.app, not in git):
# LLM_PROVIDER=qwen
# LLM_MODEL=qwen-plus
# LLM_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=your_dashscope_api_key

LLM_TIMEOUT_MS=60000
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

AGENT_SSE_TIMEOUT_MS=300000
AGENT_EXECUTOR_CORE_POOL_SIZE=4
AGENT_EXECUTOR_MAX_POOL_SIZE=20
AGENT_EXECUTOR_QUEUE_CAPACITY=200
AGENT_MAX_CONCURRENT_SESSIONS=100

# Distributed tracing (local dev; disable in prod when using SkyWalking agent)
TRACING_ENABLED=true
TRACING_SAMPLING_PROBABILITY=1.0
OTEL_SERVICE_NAME=careermate-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces

# SkyWalking (production UI — install agent on server, see docs/skywalking-cloud-setup.md)
SKYWALKING_AGENT_SERVICE_NAME=careermate-backend
SKYWALKING_COLLECTOR_BACKEND_SERVICE=skywalking-oap:11800
# JAVA_TOOL_OPTIONS=-javaagent:/opt/skywalking-agent/skywalking-agent.jar -Dskywalking.agent.service_name=careermate-backend -Dskywalking.collector.backend_service=skywalking-oap:11800

# RAGForge integration. Disabled by default; enable only when RAGForge and KB IDs are ready.
RAGFORGE_ENABLED=false
RAGFORGE_URL=http://localhost:8080
RAGFORGE_API_KEY=
RAGFORGE_TIMEOUT_MS=5000
RAGFORGE_REQUESTED_AUDIENCE=ragforge-api
RAGFORGE_REQUESTED_SCOPES=rag:search
RAGFORGE_EXCHANGED_TOKEN_CACHE_TTL_MS=300000
RAGFORGE_JD_KB_ID=
RAGFORGE_INTERVIEW_KB_ID=
RAGFORGE_PERSONAL_KB_ID=

# Aliyun SMS (mobile login). Secrets only in server env, never commit real keys.
ALIYUN_SMS_ENABLED=false
ALIYUN_SMS_MOCK_ENABLED=true
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
# Sign name with non-ASCII chars: use \\u escapes in .env (Spring reads .properties as ISO-8859-1)
# Example gift sign: ALIYUN_SMS_SIGN_NAME=\\u6052\\u521B\\u8054\\u4F17\\u79D1\\u6280
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE_LOGIN=
ALIYUN_SMS_REGION=cn-hangzhou
# Optional pepper for phone/ip hash keys; defaults to JWT_SECRET when empty
ALIYUN_SMS_PHONE_HASH_PEPPER=

# Redis (required in production for SMS rate limiting; dev/test use in-memory fallback)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=2000ms

# Optional MCP JSON-RPC endpoint
CAREERMATE_MCP_ENABLED=false
