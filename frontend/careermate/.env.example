# Local development (Vite proxy forwards /api → backend)
VITE_API_BASE_URL=/api
VITE_BASE_PATH=/
VITE_DEV_PORT=5174
VITE_API_PROXY_TARGET=http://localhost:8081

# 开发期跳过登录（true=不拦路由、401 不跳登录页）；上线前改为 false 或删除
# VITE_SKIP_AUTH=true

# Production build (careerforge.cn root path) — see deploy/env/careermate-frontend.env.example
