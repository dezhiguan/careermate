<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProperty scope="context" name="APP_NAME" source="spring.application.name" defaultValue="careermate-backend"/>

    <!-- Unified fields for console, JSON, and SkyWalking OAP Logs -->
    <property name="UNIFIED_LOG_PATTERN"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} level=%level service=%X{service:-${APP_NAME}} traceId=%X{traceId:-} requestId=%X{requestId:-} sessionId=%X{sessionId:-} userId=%X{userId:-} thread=%thread logger=%logger{36} msg=%msg%ex%n"/>

    <property name="CONSOLE_LOG_PATTERN"
              value="%clr(%d{yyyy-MM-dd HH:mm:ss.SSS}){faint} %clr([%thread]){magenta} %clr(%-5level) %clr(%logger{36}){cyan} %clr(service=%X{service:-${APP_NAME}} traceId=%X{traceId:-} requestId=%X{requestId:-} userId=%X{userId:-} sessionId=%X{sessionId:-}){yellow} %clr(-){faint} %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <withJansi>false</withJansi>
    </appender>

    <!-- SkyWalking log reporter: only when prod or explicit skywalking-log profile is active -->
    <springProfile name="prod | skywalking-log">
        <appender name="SKYWALKING_GRPC" class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.log.GRPCLogClientAppender">
            <encoder class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
                <layout class="org.apache.skywalking.apm.toolkit.log.logback.v1.x.mdc.TraceIdMDCPatternLogbackLayout">
                    <Pattern>${UNIFIED_LOG_PATTERN}</Pattern>
                </layout>
            </encoder>
        </appender>
    </springProfile>

    <springProfile name="json-logging &amp; (prod | skywalking-log)">
        <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>${UNIFIED_LOG_PATTERN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON_CONSOLE"/>
            <appender-ref ref="SKYWALKING_GRPC"/>
        </root>
    </springProfile>

    <springProfile name="json-logging &amp; !prod &amp; !skywalking-log">
        <appender name="JSON_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>${UNIFIED_LOG_PATTERN}</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON_CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="!json-logging &amp; (prod | skywalking-log)">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="SKYWALKING_GRPC"/>
        </root>
    </springProfile>

    <springProfile name="!json-logging &amp; !prod &amp; !skywalking-log">
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>
</configuration>
