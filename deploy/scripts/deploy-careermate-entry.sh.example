#!/usr/bin/env bash
set -euo pipefail

# Template only. Do not run blindly on production.
# This script does NOT modify Nginx/RAGForge. It prepares CareerMate directories and backend service artifacts.

BASE_DIR="/opt/careermate"
BACKEND_DIR="${BASE_DIR}/backend"
FRONTEND_DIR="${BASE_DIR}/frontend"
LOG_DIR="${BASE_DIR}/logs"
RELEASES_DIR="${BASE_DIR}/releases"
SCRIPTS_DIR="${BASE_DIR}/scripts"
SHARED_ENV_DIR="/opt/shared/env"

echo "[1/4] Prepare directory layout..."
mkdir -p "${BACKEND_DIR}" "${FRONTEND_DIR}" "${LOG_DIR}" "${RELEASES_DIR}" "${SCRIPTS_DIR}" "${SHARED_ENV_DIR}"

echo "[2/4] Validate required files..."
if [[ ! -f "${SHARED_ENV_DIR}/common.env" || ! -f "${SHARED_ENV_DIR}/careermate.env" ]]; then
  echo "ERROR: shared env files not found under ${SHARED_ENV_DIR}"
  exit 1
fi
if [[ ! -f "${BASE_DIR}/docker-compose-backend.yml" ]]; then
  echo "ERROR: ${BASE_DIR}/docker-compose-backend.yml not found"
  exit 1
fi
if [[ ! -f "${FRONTEND_DIR}/dist/index.html" ]]; then
  echo "ERROR: ${FRONTEND_DIR}/dist/index.html not found"
  exit 1
fi

echo "[3/4] Validate Docker availability..."
if ! docker compose version >/dev/null 2>&1; then
  echo "ERROR: docker compose is unavailable"
  exit 1
fi

echo "[4/4] Recommended startup flow (manual):"
echo "  cd ${BASE_DIR}"
echo "  docker compose -f docker-compose-backend.yml up -d --force-recreate"
echo "  docker compose -f docker-compose-backend.yml ps"

echo "Done. Template completed checks only."
