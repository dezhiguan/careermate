SERVER_PORT=18080
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=<CHANGE_ME_JWT_SECRET>
JWT_EXPIRATION_MS=86400000

DB_URL=jdbc:postgresql://172.25.90.183:5432/careermate_db
DB_USERNAME=careermate
DB_PASSWORD=<CHANGE_ME_DB_PASSWORD>

REDIS_HOST=172.25.90.183
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=2000ms

# 生产推荐：阿里云百炼 Qwen（OpenAI 兼容模式）
LLM_PROVIDER=qwen
LLM_MODEL=qwen-plus
LLM_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY is loaded from /opt/shared/env/common.env in production.

# 本地/CI 可改回 mock：
# LLM_PROVIDER=mock
# LLM_MODEL=mock-chat
# LLM_API_KEY=
# LLM_ENDPOINT=
LLM_TIMEOUT_MS=60000
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

AGENT_SSE_TIMEOUT_MS=300000
AGENT_EXECUTOR_CORE_POOL_SIZE=4
AGENT_EXECUTOR_MAX_POOL_SIZE=20
AGENT_EXECUTOR_QUEUE_CAPACITY=200
AGENT_MAX_CONCURRENT_SESSIONS=100

SKYWALKING_AGENT_SERVICE_NAME=careermate-backend
# k8s pods on Server 3 must use host private IP (not 127.0.0.1)
SKYWALKING_COLLECTOR_BACKEND_SERVICE=172.25.90.184:11800
JAVA_TOOL_OPTIONS=-Xms512m -Xmx2g -javaagent:/opt/skywalking-agent/skywalking-agent.jar -Dskywalking.agent.service_name=careermate-backend -Dskywalking.collector.backend_service=172.25.90.184:11800

TRACING_ENABLED=false
TRACING_SAMPLING_PROBABILITY=1.0
OTEL_SERVICE_NAME=careermate-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces

# RAGForge integration (optional). On Server 3, use loopback to co-located RAGForge backend.
RAGFORGE_ENABLED=false
RAGFORGE_URL=http://127.0.0.1:8080
RAGFORGE_API_KEY=
RAGFORGE_TIMEOUT_MS=5000

# Aliyun SMS (mobile login). Secrets only in /opt/shared/env on server.
ALIYUN_SMS_ENABLED=true
ALIYUN_SMS_MOCK_ENABLED=false
# ALIYUN_SMS_ACCESS_KEY_ID / ALIYUN_SMS_ACCESS_KEY_SECRET loaded from common.env
ALIYUN_SMS_SIGN_NAME=CareerMate
ALIYUN_SMS_TEMPLATE_CODE_LOGIN=SMS_XXXXXX
ALIYUN_SMS_REGION=cn-hangzhou
