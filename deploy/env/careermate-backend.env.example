SERVER_PORT=18080
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=<CHANGE_ME_JWT_SECRET>
JWT_EXPIRATION_MS=86400000

AUTH_GATEWAY_BASE_URL=http://127.0.0.1:8090
AUTH_GATEWAY_ISSUER=https://auth.careermate.cn
AUTH_GATEWAY_AUDIENCE=careermate-api
AUTH_GATEWAY_TOKEN_ENDPOINT_AUDIENCE=https://auth.careermate.cn/oauth/token
AUTH_GATEWAY_CLIENT_ID=careermate-backend
AUTH_GATEWAY_CLIENT_ASSERTION_PRIVATE_KEY=/opt/careermate/backend/keys/careermate-backend.pem
AUTH_GATEWAY_CLIENT_ASSERTION_KID=careermate-backend
AUTH_GATEWAY_REFRESH_COOKIE_NAME=cm_refresh
AUTH_GATEWAY_REFRESH_COOKIE_DOMAIN=
AUTH_GATEWAY_REFRESH_COOKIE_PATH=/api/auth
AUTH_GATEWAY_REFRESH_COOKIE_SECURE=true
AUTH_GATEWAY_TIMEOUT_MS=3000
AUTH_EVENT_HMAC_SECRET=<CHANGE_ME_AUTH_EVENT_HMAC_SECRET>
AUTH_EVENT_SIGNATURE_HEADER=X-Auth-Event-Signature
AUTH_EVENT_TIMESTAMP_HEADER=X-Auth-Event-Timestamp
AUTH_EVENT_IDEMPOTENCY_TTL=7d
AUTH_REVOKED_JTI_TTL=7d
AUTH_USER_REVOCATION_TTL=30d
TRUST_PROXY_HEADERS=true

DB_URL=jdbc:postgresql://172.25.90.183:5432/careermate_db
DB_USERNAME=careermate
DB_PASSWORD=<CHANGE_ME_DB_PASSWORD>

REDIS_HOST=172.25.90.183
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TIMEOUT=2000ms

# 生产推荐：阿里云百炼 Qwen（OpenAI 兼容模式）
LLM_PROVIDER=qwen
LLM_MODEL=qwen-plus
LLM_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY is loaded from /opt/shared/env/common.env in production.

# 本地/CI 可改回 mock：
# LLM_PROVIDER=mock
# LLM_MODEL=mock-chat
# LLM_API_KEY=
# LLM_ENDPOINT=
LLM_TIMEOUT_MS=60000
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

AGENT_SSE_TIMEOUT_MS=300000
AGENT_EXECUTOR_CORE_POOL_SIZE=4
AGENT_EXECUTOR_MAX_POOL_SIZE=20
AGENT_EXECUTOR_QUEUE_CAPACITY=200
AGENT_MAX_CONCURRENT_SESSIONS=100

# Business vs framework log levels (console + SkyWalking business logger)
APP_LOG_LEVEL=INFO
FRAMEWORK_LOG_LEVEL=WARN

SKYWALKING_AGENT_SERVICE_NAME=careermate-backend
# k8s pods on Server 3 must use host private IP (not 127.0.0.1)
SKYWALKING_COLLECTOR_BACKEND_SERVICE=172.25.90.184:11800
JAVA_TOOL_OPTIONS=-Xms512m -Xmx2g -javaagent:/opt/skywalking-agent/skywalking-agent.jar -Dskywalking.agent.service_name=careermate-backend -Dskywalking.collector.backend_service=172.25.90.184:11800

TRACING_ENABLED=false
TRACING_SAMPLING_PROBABILITY=1.0
OTEL_SERVICE_NAME=careermate-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318/v1/traces

# RAGForge integration (optional). On Server 3, use loopback to co-located RAGForge backend.
RAGFORGE_ENABLED=false
RAGFORGE_URL=http://127.0.0.1:8080
RAGFORGE_API_KEY=
# 数据组织 key（职场数据分享有限公司 org316：JD/面试/公司/市场/技能库）；留空则回退 RAGFORGE_API_KEY
RAGFORGE_DATA_API_KEY=
RAGFORGE_TIMEOUT_MS=5000
RAGFORGE_REQUESTED_AUDIENCE=ragforge-api
RAGFORGE_REQUESTED_SCOPES=rag:search
RAGFORGE_EXCHANGED_TOKEN_CACHE_TTL_MS=300000
# 启用 RAGFORGE_ENABLED=true 后需配置对应知识库 ID，否则检索会降级为 KB_NOT_CONFIGURED
RAGFORGE_JD_KB_ID=
RAGFORGE_INTERVIEW_KB_ID=
RAGFORGE_PERSONAL_KB_ID=

# Aliyun SMS (mobile login). Secrets only in /opt/shared/env on server.
ALIYUN_SMS_ENABLED=true
ALIYUN_SMS_MOCK_ENABLED=false
# ALIYUN_SMS_ACCESS_KEY_ID / ALIYUN_SMS_ACCESS_KEY_SECRET loaded from common.env
ALIYUN_SMS_SIGN_NAME=CareerMate
ALIYUN_SMS_TEMPLATE_CODE_LOGIN=SMS_XXXXXX
ALIYUN_SMS_REGION=cn-hangzhou

CAREERMATE_AUTH_SMS_STORAGE=redis
CAREERMATE_MCP_ENABLED=false
