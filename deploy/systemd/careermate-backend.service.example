[Unit]
Description=CareerMate Backend
After=network.target

[Service]
WorkingDirectory=/opt/careermate/current/backend
EnvironmentFile=/opt/careermate/backend/.env.app
# Install this unit on Server 3 (app layer, 8.138.191.228 / 172.25.90.184).
# SkyWalking Java Agent (install via deploy/scripts/install-skywalking-agent.sh).
# Collector must be reachable from this host (e.g. 127.0.0.1:11800 when OAP maps localhost).
# JAVA_TOOL_OPTIONS is read automatically by the java launcher.
# JVM heap (-Xms/-Xmx) is merged here with the SkyWalking javaagent — do not override in ExecStart.
Environment=JAVA_TOOL_OPTIONS=-Xms512m -Xmx2g -javaagent:/opt/skywalking-agent/skywalking-agent.jar -Dskywalking.agent.service_name=careermate-backend -Dskywalking.collector.backend_service=127.0.0.1:11800
# When SkyWalking UI is the primary trace backend, set TRACING_ENABLED=false in .env.app
# to avoid OTLP exporter errors when no collector is running.
ExecStart=/usr/bin/java -jar /opt/careermate/current/backend/app.jar
Restart=always
RestartSec=5
StandardOutput=append:/opt/careermate/logs/backend.log
StandardError=append:/opt/careermate/logs/backend-error.log

# Prefer a dedicated service account. If the server has no `careermate` user yet,
# create one or temporarily use the deploy user (e.g. root) until the account exists.
User=careermate

[Install]
WantedBy=multi-user.target
