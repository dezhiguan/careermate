server {
    listen 80;
    server_name your-domain.example.com;

    # CareerMate Frontend (Plan A: /careermate/)
    location /careermate/ {
        alias /opt/careermate/frontend/dist/;
        try_files $uri $uri/ /careermate/index.html;
    }

    # CareerMate API (Plan A: /careermate-api/ -> Server 3 backend /api/)
    location /careermate-api/ {
        proxy_pass http://172.25.90.184:18080/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # SSE / 长连接流式（Agent messages/stream）
        proxy_http_version 1.1;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
