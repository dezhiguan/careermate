# CareerMate location snippet for Server 2 ingress Nginx.
# Merge these locations into the RAGForge server block after backup.
# Do not add another listen 80 server block on a host that already serves RAGForge.
# If Nginx runs in a container, alias must use container-visible path:
#   /usr/share/nginx/html/careermate/ (host: /opt/rag-forge/frontend/dist/careermate/)

location /careermate/ {
    alias /usr/share/nginx/html/careermate/;
    try_files $uri $uri/ /careermate/index.html;
}

location /careermate-api/ {
    # Server 2 Nginx proxies to Server 3 app layer (172.25.90.184:18080).
    # Do not proxy to 127.0.0.1 when Nginx is inside Docker.
    proxy_pass http://172.25.90.184:18080/api/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # SSE / 长连接流式（Agent messages/stream）
    proxy_http_version 1.1;
    proxy_set_header Connection '';
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
}
