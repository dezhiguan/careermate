# CareerMate location snippet for an existing Nginx server block.
# Merge these locations into the current RAGForge/ingress server block after backup.
# Do not add another listen 80 server block blindly on a server that already hosts RAGForge.

location /careermate/ {
    alias /opt/careermate/frontend/dist/;
    try_files $uri $uri/ /careermate/index.html;
}

location /careermate-api/ {
    proxy_pass http://127.0.0.1:18080/api/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # SSE requirements
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_buffering off;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
}
