# CareerMate location snippet for an existing Nginx server block.
# Merge these locations into the current RAGForge/ingress server block after backup.
# Do not add another listen 80 server block blindly on a server that already hosts RAGForge.
# If Nginx runs in a container, alias must use container-visible path.
# Example: /usr/share/nginx/html/careermate/ (mapped from host volume).

location /careermate/ {
    alias /usr/share/nginx/html/careermate/;
    try_files $uri $uri/ /careermate/index.html;
}

location /careermate-api/ {
    # Do not proxy to 127.0.0.1 when Nginx is inside Docker.
    # Use host private IP or Docker gateway.
    proxy_pass http://172.19.40.32:18080/api/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # SSE requirements
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
}
