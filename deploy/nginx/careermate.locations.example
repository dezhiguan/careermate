# CareerForge location snippet for Server 2 ingress Nginx (careerforge.cn server block).
# Canonical config lives in rag-forge/nginx.conf; merge only if maintaining a fork.
# If Nginx runs in a container, root must use container-visible path:
#   /usr/share/nginx/html/careerforge/ (host: /opt/rag-forge/frontend/dist/careerforge/)

location = /index.html {
    root /usr/share/nginx/html/careerforge;
    add_header Cache-Control "no-store";
}

location / {
    root /usr/share/nginx/html/careerforge;
    try_files $uri $uri/ /index.html;
}

# Define once in http context (see rag-forge/nginx.conf):
# upstream careermate_backend {
#     ip_hash;
#     server 172.19.40.32:18080;
#     server 172.19.40.32:18081;
#     server 172.19.40.32:18082;
#     keepalive 32;
# }

location /api/ {
    # Server 2 Nginx proxies through local SSH tunnels to Server 3 app layer.
    proxy_pass http://careermate_backend/api/;
    proxy_set_header Host careerforge.cn;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # SSE / 长连接流式（Agent messages/stream）
    proxy_http_version 1.1;
    proxy_set_header Connection '';
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
}
